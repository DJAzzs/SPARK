ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-13.2/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=spark_v3_twofour_ext -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/dja/.local/lib/python3.14/site-packages/torch/include -isystem /home/dja/.local/lib/python3.14/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda-13.2/include -isystem /usr/include/python3.14 -fPIC -std=c++20
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=spark_v3_twofour_ext -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/dja/.local/lib/python3.14/site-packages/torch/include -isystem /home/dja/.local/lib/python3.14/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda-13.2/include -isystem /usr/include/python3.14 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_120,code=sm_120 -gencode=arch=compute_121,code=compute_121 -gencode=arch=compute_121,code=sm_121 --compiler-options '-fPIC' -O3 -I/home/dja/桌面/SPARK/01_core -std=c++20
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/home/dja/.local/lib/python3.14/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/local/cuda-13.2/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc -MD -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build main.o: compile /home/dja/桌面/SPARK/.build/v3_twofour/main.cpp
build cuda.cuda.o: cuda_compile /home/dja/桌面/SPARK/.build/v3_twofour/cuda.cu





build spark_v3_twofour_ext.so: link main.o cuda.cuda.o

default spark_v3_twofour_ext.so
